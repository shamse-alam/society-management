# Database (PostgreSQL in production)
DATABASE_URL=jdbc:postgresql://localhost:5432/societydb
DB_USERNAME=postgres
DB_PASSWORD=your_password

# JWT Secret (min 256 bits / 32+ characters)
JWT_SECRET=your-super-secret-key-change-this-in-production-must-be-long

# Frontend URL (for password reset emails)
FRONTEND_URL=https://yourdomain.com

# CORS allowed origins
CORS_ORIGINS=https://yourdomain.com

# Mail
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_app_password

# Server port (most cloud platforms set this automatically)
PORT=8080
